---
layout: base.njk
pagination:
  data: tools
  size: 1
  alias: tool
permalink: "/tools/{{ tool.slug }}/"
eleventyComputed:
  title: "{{ tool.seoTitle or tool.name }}"
  description: "{{ tool.description }}"
---

<section class="page-hero{% if tool.slug == 'keyword-density-checker' %} keyword-page-hero task-tool-page-hero{% endif %}{% if tool.slug == 'utm-link-checker' or tool.slug == 'meta-tag-generator' or tool.slug == 'cpc-roas-calculator' or tool.slug == 'word-counter' or tool.slug == 'readability-checker' or tool.slug == 'serp-snippet-preview' %} task-tool-page-hero{% endif %}{% if tool.slug == 'utm-builder' %} utm-builder-page-hero{% endif %}">
  <div class="container">
    <div class="tool-hero{% if tool.slug == 'keyword-density-checker' or tool.slug == 'utm-link-checker' or tool.slug == 'meta-tag-generator' or tool.slug == 'cpc-roas-calculator' or tool.slug == 'word-counter' or tool.slug == 'readability-checker' or tool.slug == 'serp-snippet-preview' %} task-tool-hero{% endif %}{% if tool.slug == 'utm-builder' %} utm-builder-hero{% endif %}">
      <div>
        <span class="eyebrow">{{ tool.category }}</span>
        <h1>{{ tool.name }}</h1>
        <p class="page-hero-lead">
          {{ tool.description }}
        </p>
      </div>
      {% if tool.slug != "utm-builder" and tool.slug != "keyword-density-checker" and tool.slug != "utm-link-checker" and tool.slug != "meta-tag-generator" and tool.slug != "cpc-roas-calculator" and tool.slug != "word-counter" and tool.slug != "readability-checker" and tool.slug != "serp-snippet-preview" %}
        <div class="tool-hero-note">
          <strong>Free to use</strong>
          <span>No account required. Built for quick browser workflows.</span>
        </div>
      {% endif %}
    </div>
  </div>
</section>

<section class="section-tight{% if tool.slug == 'utm-builder' %} utm-builder-section{% endif %}{% if tool.slug == 'keyword-density-checker' or tool.slug == 'utm-link-checker' or tool.slug == 'meta-tag-generator' or tool.slug == 'cpc-roas-calculator' or tool.slug == 'word-counter' or tool.slug == 'readability-checker' or tool.slug == 'serp-snippet-preview' %} task-tool-section{% endif %}">
  <div class="container">
    <div class="page-grid{% if tool.slug == 'keyword-density-checker' %} keyword-page-grid task-tool-page-grid{% endif %}{% if tool.slug == 'utm-link-checker' or tool.slug == 'meta-tag-generator' or tool.slug == 'cpc-roas-calculator' or tool.slug == 'word-counter' or tool.slug == 'readability-checker' or tool.slug == 'serp-snippet-preview' %} task-tool-page-grid{% endif %}{% if tool.slug == 'utm-builder' %} utm-builder-page-grid{% endif %}">
      <div>
        <div class="tool-panel{% if tool.slug == 'utm-builder' %} utm-builder-panel{% endif %}{% if tool.slug == 'keyword-density-checker' or tool.slug == 'utm-link-checker' or tool.slug == 'meta-tag-generator' or tool.slug == 'cpc-roas-calculator' or tool.slug == 'word-counter' or tool.slug == 'readability-checker' or tool.slug == 'serp-snippet-preview' %} task-tool-panel{% endif %}">
          {% if tool.slug != "utm-builder" and tool.slug != "keyword-density-checker" and tool.slug != "utm-link-checker" and tool.slug != "meta-tag-generator" and tool.slug != "cpc-roas-calculator" and tool.slug != "word-counter" and tool.slug != "readability-checker" and tool.slug != "serp-snippet-preview" %}
            <h2>Use the {{ tool.name }}</h2>
            <p class="muted">
              Enter your inputs below and the results will update in the browser.
            </p>
          {% endif %}

          {% if tool.slug == "word-counter" %}
            <div class="task-workspace phase-six-workspace word-workspace" data-word-counter>
              <header class="task-workspace-heading">
                <div>
                  <span class="mini-label">Writing workspace</span>
                  <h2>Count and review your draft</h2>
                  <p>Paste text once and see useful length and timing metrics immediately.</p>
                </div>
                <span class="task-live-indicator"><span aria-hidden="true"></span>Live counts</span>
              </header>

              <div class="phase-six-tool-layout">
                <section class="phase-six-input-panel" aria-labelledby="wordInputHeading">
                  <div class="task-step-heading">
                    <span aria-hidden="true">1</span>
                    <div><h3 id="wordInputHeading">Add your text</h3><p>Article, landing page, email, essay, or social copy.</p></div>
                  </div>
                  <div class="phase-six-input-meta"><span id="wordInputCount">0</span> characters</div>
                  <label class="task-field-label" for="textInput">Text to count</label>
                  <textarea id="textInput" class="tool-input phase-six-textarea" aria-describedby="wordMethod" placeholder="Paste your draft here..."></textarea>
                  <div class="task-actions">
                    <button id="sampleBtn" class="btn btn-secondary" type="button">Load Example</button>
                    <button id="clearBtn" class="task-reset-button" type="button">Reset</button>
                  </div>
                </section>

                <section class="phase-six-result-panel" data-word-state="waiting" aria-labelledby="wordResultsHeading">
                  <div class="task-result-heading">
                    <div><span class="mini-label">Document overview</span><h3 id="wordResultsHeading">Length and timing</h3></div>
                    <button id="wordCopyBtn" class="btn btn-primary btn-sm" type="button" disabled>Copy report</button>
                  </div>
                  <p id="wordStatus" class="task-status-message" role="status" aria-live="polite">Add text to begin counting.</p>
                  <div class="phase-six-primary-result">
                    <span>Words</span>
                    <strong id="wordCount">0</strong>
                    <small><span id="readingTime">0 min</span> estimated reading time</small>
                  </div>
                  <dl class="phase-six-metric-grid">
                    <div><dt>Characters</dt><dd id="charCount">0</dd></div>
                    <div><dt>Without spaces</dt><dd id="charNoSpaceCount">0</dd></div>
                    <div><dt>Sentences</dt><dd id="sentenceCount">0</dd></div>
                    <div><dt>Paragraphs</dt><dd id="paragraphCount">0</dd></div>
                    <div><dt>Speaking time</dt><dd id="speakingTime">0 min</dd></div>
                    <div><dt>Average sentence</dt><dd><span id="avgWordsPerSentence">0</span> words</dd></div>
                  </dl>
                  <p id="wordMethod" class="task-method-note">Timing estimates use 200 words per minute for reading and 130 words per minute for speaking.</p>
                </section>
              </div>
            </div>

          {% elif tool.slug == "keyword-density-checker" %}
            <div class="task-workspace keyword-workspace" data-keyword-density>
              <div class="task-workspace-heading">
                <div>
                  <span class="mini-label">Content analysis</span>
                  <h2>Check repeated words in your draft</h2>
                  <p>Paste content to see individual-word frequency and density as you type.</p>
                </div>
                <span class="task-live-indicator"><span aria-hidden="true"></span>Live</span>
              </div>

              <div class="keyword-tool-layout">
                <section class="keyword-input-panel" aria-labelledby="densityInputHeading">
                  <div class="task-step-heading">
                    <span aria-hidden="true">1</span>
                    <div>
                      <h3 id="densityInputHeading">Add your content</h3>
                      <p>Article, landing page, product copy, or another draft.</p>
                    </div>
                  </div>

                  <div class="keyword-input-meta"><span id="densityCharCount">0</span> characters</div>
                  <label class="task-field-label" for="densityText">Content to analyze</label>
                  <textarea id="densityText" class="tool-input keyword-tool-textarea" aria-describedby="densityMethod" placeholder="Paste your content here..."></textarea>

                  <div class="task-actions keyword-tool-actions">
                    <button id="densitySampleBtn" class="btn btn-secondary" type="button">Load Example</button>
                    <button id="densityClearBtn" class="task-reset-button" type="button">Clear text</button>
                  </div>
                </section>

                <section class="keyword-results-panel" aria-labelledby="densityResultsHeading">
                  <div class="task-result-heading">
                    <div>
                      <span class="mini-label">Results</span>
                      <h3 id="densityResultsHeading">Repeated terms</h3>
                    </div>
                    <button id="densityCopyBtn" class="btn btn-primary btn-sm" type="button" disabled>Copy report</button>
                  </div>

                  <p id="densityStatus" class="task-status-message" role="status" aria-live="polite">Add content to start the analysis.</p>

                  <dl class="keyword-stat-grid">
                    <div class="keyword-stat-box"><dt>Total words</dt><dd id="densityWordCount">0</dd></div>
                    <div class="keyword-stat-box"><dt>Distinct terms</dt><dd id="densityUniqueCount">0</dd></div>
                    <div class="keyword-stat-box"><dt>Top term</dt><dd id="densityTopKeyword">-</dd></div>
                    <div class="keyword-stat-box"><dt>Top density</dt><dd id="densityTopPercent">0%</dd></div>
                  </dl>

                  <div class="keyword-table-wrap">
                    <table class="keyword-results-table">
                      <thead>
                        <tr>
                          <th>Term</th>
                          <th>Count</th>
                          <th>Density</th>
                        </tr>
                      </thead>
                      <tbody id="densityResults">
                        <tr><td colspan="3">Results will appear after you add content.</td></tr>
                      </tbody>
                    </table>
                  </div>

                  <p id="densityMethod" class="task-method-note">Method: counts individual words without case sensitivity. Common English function words are excluded. Phrases and SEO quality are not evaluated.</p>
                </section>
              </div>
            </div>

          {% elif tool.slug == "readability-checker" %}
            <div class="task-workspace phase-six-workspace readability-workspace" data-readability-checker>
              <header class="task-workspace-heading">
                <div>
                  <span class="mini-label">Clarity workspace</span>
                  <h2>Review how easy your draft is to read</h2>
                  <p>Paste English text to estimate reading ease, grade level, and sentence complexity.</p>
                </div>
                <span class="task-live-indicator"><span aria-hidden="true"></span>Live analysis</span>
              </header>

              <div class="phase-six-tool-layout">
                <section class="phase-six-input-panel" aria-labelledby="readabilityInputHeading">
                  <div class="task-step-heading">
                    <span aria-hidden="true">1</span>
                    <div><h3 id="readabilityInputHeading">Add your text</h3><p>Use a complete paragraph for a more useful estimate.</p></div>
                  </div>
                  <div class="phase-six-input-meta"><span id="readabilityInputCount">0</span> characters</div>
                  <label class="task-field-label" for="readabilityText">Text to analyze</label>
                  <textarea id="readabilityText" class="tool-input phase-six-textarea" aria-describedby="readabilityMethod" placeholder="Paste your article, email, or landing page copy..."></textarea>
                  <div class="task-actions">
                    <button id="readabilitySampleBtn" class="btn btn-secondary" type="button">Load Example</button>
                    <button id="readabilityClearBtn" class="task-reset-button" type="button">Reset</button>
                  </div>
                </section>

                <section class="phase-six-result-panel readability-result-panel" data-readability-state="waiting" aria-labelledby="readabilityResultsHeading">
                  <div class="task-result-heading">
                    <div><span class="mini-label">Readability result</span><h3 id="readabilityResultsHeading">Reading ease</h3></div>
                    <button id="readabilityCopyBtn" class="btn btn-primary btn-sm" type="button" disabled>Copy report</button>
                  </div>
                  <p id="readabilityStatus" class="task-status-message" role="status" aria-live="polite">Add text to begin the analysis.</p>
                  <div class="phase-six-primary-result">
                    <span>Flesch Reading Ease</span>
                    <strong id="fleschScore">0</strong>
                    <small id="readingLevelLabel">-</small>
                  </div>
                  <dl class="phase-six-metric-grid readability-metric-grid">
                    <div><dt>Words</dt><dd id="readabilityWords">0</dd></div>
                    <div><dt>Sentences</dt><dd id="readabilitySentences">0</dd></div>
                    <div><dt>Syllables</dt><dd id="readabilitySyllables">0</dd></div>
                    <div><dt>Grade level</dt><dd id="gradeLevel">0</dd></div>
                  </dl>
                  <div class="phase-six-summary">
                    <h4>Readability summary</h4>
                    <div id="readabilitySummary"><p class="muted">Guidance will appear after you enter text.</p></div>
                  </div>
                  <p id="readabilityMethod" class="task-method-note">Method: Flesch formulas use English sentence, word, and estimated syllable counts. Treat the result as editing guidance, not a quality score.</p>
                </section>
              </div>
            </div>

          {% elif tool.slug == "meta-tag-generator" %}
            <div class="task-workspace phase-five-workspace meta-workspace" data-meta-generator>
              <header class="task-workspace-heading">
                <div>
                  <span class="mini-label">Metadata workspace</span>
                  <h2>Create page metadata</h2>
                  <p>Write the search fields first, then add optional canonical and social settings.</p>
                </div>
                <span class="task-live-indicator"><span aria-hidden="true"></span>Live preview</span>
              </header>

              <div class="phase-five-tool-layout meta-tool-layout">
                <section class="phase-five-input-panel" aria-labelledby="metaInputHeading">
                  <div class="task-step-heading">
                    <span aria-hidden="true">1</span>
                    <div>
                      <h3 id="metaInputHeading">Describe the page</h3>
                      <p>Use a unique title and an accurate summary.</p>
                    </div>
                  </div>

                  <div class="form-group">
                    <div class="field-label-row">
                      <label for="metaTitle">Page title</label>
                      <span><strong id="metaTitleCount">0</strong> characters</span>
                    </div>
                    <input id="metaTitle" class="tool-input" type="text" aria-describedby="metaTitleHint" placeholder="Example: Free Keyword Density Checker for SEO Content">
                    <p id="metaTitleHint" class="task-field-hint">Aim for a specific title that matches the page.</p>
                  </div>

                  <div class="form-group">
                    <div class="field-label-row">
                      <label for="metaDescription">Meta description</label>
                      <span><strong id="metaDescriptionCount">0</strong> characters</span>
                    </div>
                    <textarea id="metaDescription" class="tool-input meta-description-input" aria-describedby="metaDescriptionHint" placeholder="Write a concise page description for search results and social previews..."></textarea>
                    <p id="metaDescriptionHint" class="task-field-hint">Summarize what visitors will find after they click.</p>
                  </div>

                  <details class="phase-five-details">
                    <summary>Canonical and social settings <small>Optional</small></summary>
                    <div class="phase-five-details-body">
                      <div class="form-group">
                        <div class="field-label-row">
                          <label for="metaCanonical">Canonical URL</label>
                          <span id="metaCanonicalStatus">Missing</span>
                        </div>
                        <input id="metaCanonical" class="tool-input" type="url" placeholder="https://example.com/page/">
                      </div>

                      <div class="form-group">
                        <label for="metaRobots">Robots directive</label>
                        <input id="metaRobots" class="tool-input" type="text" value="index, follow" placeholder="index, follow">
                      </div>

                      <div class="form-group">
                        <div class="field-label-row">
                          <label for="metaOgImage">Social image URL</label>
                          <span id="metaImageStatus">Missing</span>
                        </div>
                        <input id="metaOgImage" class="tool-input" type="url" placeholder="https://example.com/og-image.jpg">
                      </div>
                    </div>
                  </details>

                  <div class="task-actions">
                    <button id="metaSampleBtn" class="btn btn-secondary" type="button">Load Example</button>
                    <button id="metaClearBtn" class="task-reset-button" type="button">Reset</button>
                  </div>
                </section>

                <section class="phase-five-result-panel meta-result-panel" data-meta-state="waiting" aria-labelledby="metaResultHeading">
                  <div class="task-result-heading">
                    <div>
                      <span class="mini-label">Generated output</span>
                      <h3 id="metaResultHeading">Meta tags</h3>
                    </div>
                    <button id="metaCopyBtn" class="btn btn-primary btn-sm" type="button" disabled>Copy tags</button>
                  </div>

                  <p id="metaStatus" class="task-status-message" role="status" aria-live="polite">Add a page title or description to create page-specific tags.</p>
                  <label class="sr-only" for="metaOutput">Generated meta tags</label>
                  <textarea id="metaOutput" class="tool-input meta-output" rows="14" readonly aria-describedby="metaStatus" placeholder="Your generated meta tags will appear here..."></textarea>

                  <div class="phase-five-guidance">
                    <h4>Review before publishing</h4>
                    <div id="metaTips">
                      <p class="muted">Guidance will appear here as you fill in the fields.</p>
                    </div>
                  </div>
                </section>
              </div>
            </div>

          {% elif tool.slug == "serp-snippet-preview" %}
            <div class="task-workspace phase-six-workspace serp-workspace" data-serp-snippet>
              <header class="task-workspace-heading">
                <div>
                  <span class="mini-label">Search preview workspace</span>
                  <h2>Shape your search listing</h2>
                  <p>Edit the title, description, and URL while reviewing the snippet beside them.</p>
                </div>
                <span class="task-live-indicator"><span aria-hidden="true"></span>Live preview</span>
              </header>

              <div class="phase-six-tool-layout serp-tool-layout">
              <section class="phase-six-input-panel serp-fields" aria-labelledby="serpInputHeading">
                <div class="task-step-heading">
                  <span aria-hidden="true">1</span>
                  <div><h3 id="serpInputHeading">Add search details</h3><p>Start with the title and description searchers will scan.</p></div>
                </div>
                <div class="form-group">
                  <div class="field-label-row">
                    <label for="serpTitle">Page title</label>
                    <span id="serpTitleCount">0 / 60</span>
                  </div>
                  <input id="serpTitle" class="tool-input" type="text" maxlength="120" placeholder="Enter the title shown in search results">
                  <div class="serp-field-status">
                    <span id="serpTitleStatus" data-tone="missing">Missing</span>
                    <small>30 to 60 characters is a practical editing range.</small>
                  </div>
                </div>

                <div class="form-group">
                  <div class="field-label-row">
                    <label for="serpDescription">Meta description</label>
                    <span id="serpDescriptionCount">0 / 160</span>
                  </div>
                  <textarea id="serpDescription" class="tool-input serp-description-input" maxlength="320" placeholder="Write a clear reason for searchers to visit the page"></textarea>
                  <div class="serp-field-status">
                    <span id="serpDescriptionStatus" data-tone="missing">Missing</span>
                    <small>120 to 160 characters usually gives enough useful context.</small>
                  </div>
                </div>

                <div class="form-group">
                  <label for="serpUrl">Page URL</label>
                  <input id="serpUrl" class="tool-input" type="url" placeholder="https://example.com/page/">
                </div>

                <div class="hero-actions serp-actions">
                  <button id="serpSampleBtn" class="btn btn-secondary" type="button">Load Example</button>
                  <button id="serpClearBtn" class="task-reset-button" type="button">Reset</button>
                </div>
              </section>

              <section class="phase-six-result-panel serp-preview-panel" data-serp-state="waiting" aria-labelledby="serpResultHeading">
                <div class="task-result-heading">
                  <div><span class="mini-label">Generated preview</span><h3 id="serpResultHeading">Google search snippet</h3></div>
                  <button id="serpCopyBtn" class="btn btn-primary btn-sm" type="button" disabled>Copy preview</button>
                </div>
                <p id="serpStatus" class="task-status-message" role="status" aria-live="polite">Add a title, description, or URL to create a page-specific preview.</p>
                <div class="serp-preview-head phase-six-preview-controls">
                  <span>Preview width</span>
                  <div class="serp-device-switch" aria-label="Preview size">
                    <button class="is-active" type="button" data-serp-device="desktop" aria-pressed="true">Desktop</button>
                    <button type="button" data-serp-device="mobile" aria-pressed="false">Mobile</button>
                  </div>
                </div>

                <div id="serpPreview" class="serp-preview" data-device="desktop" aria-live="polite">
                  <div class="serp-source-row">
                    <span class="serp-source-icon" aria-hidden="true">UD</span>
                    <div>
                      <strong>UD Marketing Tools</strong>
                      <span id="serpPreviewUrl">https://example.com/page/</span>
                    </div>
                  </div>
                  <p id="serpPreviewTitle" class="serp-preview-title">Your page title will appear here</p>
                  <p id="serpPreviewDescription" class="serp-preview-description">Add a meta description to preview how your page could look in Google search results.</p>
                </div>

                <div class="serp-preview-note">
                  <p>Google may rewrite or shorten a snippet. Use this preview for editing, not as a guaranteed display.</p>
                </div>
              </section>
              </div>
            </div>

          {% elif tool.slug == "cpc-roas-calculator" %}
            <div class="task-workspace phase-five-workspace roas-workspace" data-roas-calculator>
              <header class="task-workspace-heading">
                <div>
                  <span class="mini-label">Campaign calculator</span>
                  <h2>Measure campaign efficiency</h2>
                  <p>Use numbers from the same campaign period and currency for a useful comparison.</p>
                </div>
                <span class="task-live-indicator"><span aria-hidden="true"></span>Live results</span>
              </header>

              <div class="phase-five-tool-layout roas-tool-layout">
                <section class="phase-five-input-panel" aria-labelledby="roasInputHeading">
                  <div class="task-step-heading">
                    <span aria-hidden="true">1</span>
                    <div>
                      <h3 id="roasInputHeading">Enter campaign totals</h3>
                      <p>Spend and revenue calculate ROAS. Clicks and conversions add context.</p>
                    </div>
                  </div>

                  <div class="roas-field-grid">
                    <div class="form-group">
                      <label for="adSpend">Ad spend</label>
                      <input id="adSpend" class="tool-input" type="number" min="0" step="0.01" inputmode="decimal" placeholder="1000">
                    </div>

                    <div class="form-group">
                      <label for="revenue">Revenue from ads</label>
                      <input id="revenue" class="tool-input" type="number" min="0" step="0.01" inputmode="decimal" placeholder="4000">
                    </div>

                    <div class="form-group">
                      <label for="clicks">Clicks</label>
                      <input id="clicks" class="tool-input" type="number" min="0" step="1" inputmode="numeric" placeholder="500">
                    </div>

                    <div class="form-group">
                      <label for="conversions">Conversions</label>
                      <input id="conversions" class="tool-input" type="number" min="0" step="1" inputmode="numeric" placeholder="25">
                    </div>
                  </div>

                  <p class="task-method-note">Use one currency consistently. Revenue minus spend does not include product, shipping, salary, or service-delivery costs.</p>

                  <div class="task-actions">
                    <button id="cpcSampleBtn" class="btn btn-secondary" type="button">Load Example</button>
                    <button id="cpcClearBtn" class="task-reset-button" type="button">Reset</button>
                  </div>
                </section>

                <section class="phase-five-result-panel roas-result-panel" data-roas-state="waiting" aria-labelledby="roasResultHeading">
                  <div class="task-result-heading">
                    <div>
                      <span class="mini-label">Campaign result</span>
                      <h3 id="roasResultHeading">Return on ad spend</h3>
                    </div>
                    <span id="cpcState" class="task-result-state">Waiting</span>
                  </div>

                  <p id="cpcStatus" class="task-status-message" role="status" aria-live="polite">Add campaign totals to calculate results.</p>

                  <div class="roas-primary-result">
                    <span>ROAS</span>
                    <strong id="calcRoas">0.00x</strong>
                    <small id="calcRoasPercent">0.00%</small>
                  </div>

                  <dl class="roas-metric-grid">
                    <div><dt>Cost per click</dt><dd id="calcCpc">0.00</dd></div>
                    <div><dt>Cost per acquisition</dt><dd id="calcCpa">0.00</dd></div>
                    <div><dt>Conversion rate</dt><dd id="calcConvRate">0.00%</dd></div>
                    <div><dt>Revenue minus spend</dt><dd id="calcProfit">0.00</dd></div>
                  </dl>

                  <div class="phase-five-guidance">
                    <h4>Performance summary</h4>
                    <div id="cpcSummary">
                      <p class="muted">Campaign guidance will appear here as you fill in the fields.</p>
                    </div>
                  </div>
                </section>
              </div>
            </div>

          {% elif tool.slug == "utm-builder" %}
            <div class="utm-builder-shell">
              <header class="utm-workspace-heading">
                <span class="mini-label">Campaign URL workspace</span>
                <h2>Build a trackable campaign URL</h2>
                <p>Enter the destination and three campaign fields. Your URL is validated and generated in your browser.</p>
              </header>

              <form id="campaignForm" class="utm-builder-workspace" novalidate>
                <section class="utm-builder-form" aria-labelledby="campaignFieldsTitle">
                  <div class="utm-step-heading">
                    <span aria-hidden="true">1</span>
                    <div>
                      <h3 id="campaignFieldsTitle">Destination URL</h3>
                      <p>Use the final page visitors should reach.</p>
                    </div>
                  </div>

                  <div class="form-group utm-field">
                    <label for="campaignBaseUrl">Destination URL <span>Required</span></label>
                    <input id="campaignBaseUrl" class="tool-input" type="url" inputmode="url" autocomplete="url" spellcheck="false" required aria-describedby="campaignBaseUrlHint campaignBaseUrlError" placeholder="https://example.com/landing-page/">
                    <p id="campaignBaseUrlHint" class="utm-field-hint">Include <strong>https://</strong>. Existing non-UTM parameters and fragments are preserved.</p>
                    <p id="campaignBaseUrlError" class="utm-field-error" role="alert" hidden>Enter a complete http:// or https:// web address.</p>
                  </div>

                  <div class="utm-section-heading">
                    <span aria-hidden="true">2</span>
                    <div>
                      <h3>Campaign parameters</h3>
                      <p>These required values identify the traffic in analytics.</p>
                    </div>
                  </div>

                  <div class="utm-primary-fields">
                    <div class="form-group utm-field">
                      <label for="utmSource">Source <span>Required</span></label>
                      <input id="utmSource" class="tool-input" type="text" autocomplete="off" required aria-describedby="utmSourceHint utmSourceError" placeholder="newsletter">
                      <p id="utmSourceHint" class="utm-field-hint">Where the traffic comes from.</p>
                      <p id="utmSourceError" class="utm-field-error" role="alert" hidden>Add a campaign source.</p>
                    </div>

                    <div class="form-group utm-field">
                      <label for="utmMedium">Medium <span>Required</span></label>
                      <input id="utmMedium" class="tool-input" type="text" autocomplete="off" required aria-describedby="utmMediumHint utmMediumError" placeholder="email">
                      <p id="utmMediumHint" class="utm-field-hint">The marketing channel or method.</p>
                      <p id="utmMediumError" class="utm-field-error" role="alert" hidden>Add a campaign medium.</p>
                    </div>

                    <div class="form-group utm-field">
                      <label for="utmCampaign">Campaign <span>Required</span></label>
                      <input id="utmCampaign" class="tool-input" type="text" autocomplete="off" required aria-describedby="utmCampaignHint utmCampaignError" placeholder="summer-sale">
                      <p id="utmCampaignHint" class="utm-field-hint">A consistent name for this promotion.</p>
                      <p id="utmCampaignError" class="utm-field-error" role="alert" hidden>Add a campaign name.</p>
                    </div>
                  </div>

                  <details id="campaignOptionalFields" class="utm-optional-fields">
                    <summary>
                      <span>Optional campaign details</span>
                      <small>Content and term</small>
                    </summary>
                    <div class="utm-optional-fields-body">
                      <div class="form-group utm-field">
                        <label for="utmContent">Content</label>
                        <input id="utmContent" class="tool-input" type="text" autocomplete="off" placeholder="hero-button">
                        <p class="utm-field-hint">Distinguish links, creatives, or placements.</p>
                      </div>

                      <div class="form-group utm-field">
                        <label for="utmTerm">Term</label>
                        <input id="utmTerm" class="tool-input" type="text" autocomplete="off" placeholder="seo-tools">
                        <p class="utm-field-hint">Track paid keywords or audience terms.</p>
                      </div>
                    </div>
                  </details>

                  <div class="utm-builder-actions">
                    <button id="campaignGenerateBtn" class="btn btn-primary" type="submit">Generate URL</button>
                    <button id="campaignSampleBtn" class="btn btn-secondary" type="button">Load example</button>
                    <button id="campaignClearBtn" class="utm-reset-button" type="button">Reset</button>
                  </div>
                </section>

                <section id="campaignResultPanel" class="utm-builder-result" data-state="waiting" aria-labelledby="campaignResultTitle">
                  <div class="utm-result-heading">
                    <div>
                      <span class="mini-label">Generated result</span>
                      <h3 id="campaignResultTitle">Campaign URL</h3>
                    </div>
                    <strong id="campaignRequiredStatus" class="utm-result-state">Incomplete</strong>
                  </div>

                  <p id="campaignStatusMessage" class="utm-status-message" role="status" aria-live="polite">Add the destination and required campaign fields to generate a URL.</p>

                  <div class="utm-output-wrap">
                    <label for="campaignOutput">Generated campaign URL</label>
                    <textarea id="campaignOutput" class="tool-input" rows="5" readonly spellcheck="false" aria-describedby="campaignStatusMessage" placeholder="Your campaign URL will appear here."></textarea>
                    <button id="campaignCopyBtn" class="btn btn-primary utm-copy-button" type="button" disabled>Copy URL</button>
                  </div>

                  <dl class="utm-result-meta">
                    <div>
                      <dt>Destination</dt>
                      <dd id="campaignUrlStatus">Missing</dd>
                    </div>
                    <div>
                      <dt>URL length</dt>
                      <dd id="campaignLength">0</dd>
                    </div>
                    <div>
                      <dt>UTM fields</dt>
                      <dd id="campaignParamCount">0</dd>
                    </div>
                  </dl>

                  <div class="utm-result-guidance">
                    <h4>Validation guidance</h4>
                    <div id="campaignTips">
                      <p>Add the destination URL first. This is the page you want people to visit.</p>
                    </div>
                  </div>
                </section>
              </form>
            </div>

            <div class="utm-visual-card utm-builder-learning">
              <div class="visual-head">
                <span class="mini-label">Campaign flow</span>
                <h3>How a UTM link reaches Google Analytics</h3>
              </div>

              <div class="utm-flow" aria-label="UTM tracking flow from campaign click to analytics report">
                <div class="utm-flow-step">
                  <span class="utm-flow-icon">1</span>
                  <strong>Campaign click</strong>
                  <p>Email, ad, social post, QR code, or partner link</p>
                </div>
                <span class="utm-flow-arrow">&rarr;</span>
                <div class="utm-flow-step">
                  <span class="utm-flow-icon">2</span>
                  <strong>UTM tracking URL</strong>
                  <p><code>utm_source</code>, <code>utm_medium</code>, and <code>utm_campaign</code></p>
                </div>
                <span class="utm-flow-arrow">&rarr;</span>
                <div class="utm-flow-step">
                  <span class="utm-flow-icon">3</span>
                  <strong>Analytics report</strong>
                  <p>Compare source, medium, campaign, visits, and conversions</p>
                </div>
              </div>

              <div class="utm-example-url">
                <span>Example</span>
                <code>example.com/offer/?utm_source=newsletter&amp;utm_medium=email&amp;utm_campaign=summer_sale</code>
              </div>
            </div>

          {% elif tool.slug == "utm-link-checker" %}
            <div class="task-workspace utm-checker" data-utm-checker>
              <div class="task-workspace-heading utm-checker-heading">
                <div>
                  <span class="mini-label">Campaign validation</span>
                  <h2>Check a UTM link before publishing</h2>
                  <p>Review required campaign fields, formatting, duplicates, and fragments without opening the destination.</p>
                </div>
                <div class="utm-checker-modes" role="tablist" aria-label="UTM checker mode">
                  <button id="utmSingleTab" class="is-active" type="button" role="tab" aria-selected="true" aria-controls="utmSinglePane" tabindex="0" data-utm-mode="single">Single link</button>
                  <button id="utmBatchTab" type="button" role="tab" aria-selected="false" aria-controls="utmBatchPane" tabindex="-1" data-utm-mode="batch">Batch check</button>
                </div>
              </div>

              <section id="utmSinglePane" class="utm-checker-pane" role="tabpanel" aria-labelledby="utmSingleTab" data-utm-pane="single">
                <div class="utm-checker-single-grid">
                  <div class="utm-checker-input-panel">
                    <div class="task-step-heading">
                      <span aria-hidden="true">1</span>
                      <div><h3>Add a campaign URL</h3><p>Paste the complete URL exactly as it will be published.</p></div>
                    </div>
                    <label class="task-field-label" for="utmCheckUrl">Campaign URL</label>
                    <textarea id="utmCheckUrl" class="tool-input utm-checker-input" rows="5" spellcheck="false" aria-describedby="utmCheckHelp utmCheckNotice" placeholder="https://example.com/offer/?utm_source=newsletter&amp;utm_medium=email&amp;utm_campaign=summer_launch"></textarea>
                    <p id="utmCheckHelp" class="task-field-hint">The checker accepts complete HTTP or HTTPS URLs.</p>
                    <div class="task-actions utm-checker-actions">
                      <button id="utmCheckBtn" class="btn btn-primary" type="button">Check link</button>
                      <button id="utmCheckSampleBtn" class="btn btn-secondary" type="button">Load Example</button>
                      <button id="utmCheckClearBtn" class="task-reset-button" type="button">Reset</button>
                    </div>
                  </div>

                  <div class="utm-checker-result-panel" data-checker-state="waiting">
                    <div class="task-result-heading">
                      <div><span class="mini-label">Result</span><h3>Campaign link status</h3></div>
                      <span id="utmCheckStatus" class="task-result-state">Not checked</span>
                    </div>
                    <div id="utmCheckNotice" class="utm-checker-notice" data-tone="neutral" role="status" aria-live="polite">Paste a campaign URL and run the checker.</div>
                    <dl class="utm-checker-summary">
                      <div><dt>Required fields</dt><dd id="utmCheckRequired">0 / 3</dd></div>
                      <div><dt>Issues</dt><dd id="utmCheckIssues">0</dd></div>
                      <div><dt>Warnings</dt><dd id="utmCheckWarnings">0</dd></div>
                    </dl>
                    <label class="task-field-label" for="utmCheckOutput">Normalized URL</label>
                    <textarea id="utmCheckOutput" class="tool-input" rows="4" readonly placeholder="A normalized URL will appear after validation."></textarea>
                    <div class="utm-result-actions">
                      <button id="utmCopyUrlBtn" class="btn btn-primary" type="button" disabled>Copy URL</button>
                      <button id="utmCopyReportBtn" class="btn btn-secondary" type="button" disabled>Copy report</button>
                    </div>
                    <p class="task-method-note">Normalization lowercases UTM names and values and changes spaces to underscores. Non-UTM parameters are preserved.</p>
                  </div>
                </div>

                <details class="utm-checker-details">
                  <summary>View parameter report</summary>
                  <div class="utm-checker-table-wrap">
                    <table class="utm-checker-table">
                      <thead><tr><th>Parameter</th><th>Value</th><th>Status</th><th>Recommendation</th></tr></thead>
                      <tbody id="utmCheckResults"><tr><td colspan="4">No link checked yet.</td></tr></tbody>
                    </table>
                  </div>
                </details>
              </section>

              <section id="utmBatchPane" class="utm-checker-pane" role="tabpanel" aria-labelledby="utmBatchTab" data-utm-pane="batch" hidden>
                <div class="utm-batch-layout">
                  <div class="utm-checker-input-panel">
                    <div class="task-step-heading">
                      <span aria-hidden="true">1</span>
                      <div><h3>Add campaign URLs</h3><p>One complete URL per line, up to 100.</p></div>
                    </div>
                    <label class="task-field-label" for="utmBatchUrls">Campaign URLs</label>
                    <textarea id="utmBatchUrls" class="tool-input utm-batch-input" rows="9" spellcheck="false" placeholder="https://example.com/email/?utm_source=newsletter&amp;utm_medium=email&amp;utm_campaign=launch&#10;https://example.com/ad/?utm_source=google&amp;utm_medium=cpc&amp;utm_campaign=launch"></textarea>
                    <div class="task-actions utm-checker-actions">
                      <button id="utmBatchCheckBtn" class="btn btn-primary" type="button">Check URLs</button>
                      <button id="utmBatchSampleBtn" class="btn btn-secondary" type="button">Load Example</button>
                      <button id="utmBatchClearBtn" class="task-reset-button" type="button">Reset</button>
                    </div>
                  </div>

                  <div class="utm-batch-results-panel">
                    <div class="task-result-heading">
                      <div><span class="mini-label">Batch result</span><h3>Validation summary</h3></div>
                      <button id="utmBatchCsvBtn" class="btn btn-secondary btn-sm" type="button" disabled>Download CSV</button>
                    </div>
                    <dl class="utm-checker-summary" aria-live="polite">
                      <div><dt>Checked</dt><dd id="utmBatchTotal">0</dd></div>
                      <div><dt>Ready</dt><dd id="utmBatchValid">0</dd></div>
                      <div><dt>Review</dt><dd id="utmBatchReview">0</dd></div>
                      <div><dt>Invalid</dt><dd id="utmBatchInvalid">0</dd></div>
                    </dl>
                    <div class="utm-checker-table-wrap">
                      <table class="utm-checker-table utm-batch-table">
                        <thead><tr><th>#</th><th>URL</th><th>Status</th><th>Required</th><th>Issues</th></tr></thead>
                        <tbody id="utmBatchResults"><tr><td colspan="5">Add one URL per line to create a batch report.</td></tr></tbody>
                      </table>
                    </div>
                  </div>
                </div>
              </section>
            </div>

          {% elif tool.slug == "qr-code-generator" %}
            <div class="form-group">
              <label for="qrContent">Content to encode</label>
              <textarea id="qrContent" class="tool-input" placeholder="Enter a URL, message, phone number, email, or campaign link..."></textarea>
            </div>

            <div class="form-group">
              <label for="qrSize">QR size</label>
              <select id="qrSize" class="tool-input">
                <option value="200">200 x 200</option>
                <option value="300" selected>300 x 300</option>
                <option value="400">400 x 400</option>
                <option value="600">600 x 600</option>
              </select>
            </div>

            <div class="form-group">
              <label for="qrErrorLevel">Error correction</label>
              <select id="qrErrorLevel" class="tool-input">
                <option value="L">Low (7%)</option>
                <option value="M" selected>Medium (15%)</option>
                <option value="Q">Quartile (25%)</option>
                <option value="H">High (30%)</option>
              </select>
            </div>

            <div class="form-group">
              <label for="qrMargin">Quiet zone / margin</label>
              <select id="qrMargin" class="tool-input">
                <option value="1">1 module</option>
                <option value="2">2 modules</option>
                <option value="4" selected>4 modules</option>
                <option value="8">8 modules</option>
              </select>
            </div>

            <div class="hero-actions" style="margin-bottom:0;">
              <button id="qrClearBtn" class="btn btn-secondary" type="button">Clear</button>
              <button id="qrSampleBtn" class="btn btn-primary" type="button">Load Example</button>
            </div>

            <div class="results-grid">
              <div class="result-box">
                <strong id="qrContentStatus">-</strong>
                <span>Content</span>
              </div>
              <div class="result-box">
                <strong id="qrSelectedSize">300</strong>
                <span>Size</span>
              </div>
              <div class="result-box">
                <strong id="qrSelectedLevel">M</strong>
                <span>Error correction</span>
              </div>
              <div class="result-box">
                <strong id="qrSelectedMargin">4</strong>
                <span>Margin</span>
              </div>
            </div>

            <div class="content-card" style="margin-top:24px;">
              <h3>Generated QR code</h3>
              <div id="qrPreview" class="preview-box" style="min-height:320px;">
                <p class="muted">Your QR code preview will appear here.</p>
              </div>
            </div>

            <div class="hero-actions" style="margin-top:24px; margin-bottom:0;">
              <button id="qrDownloadPngBtn" class="btn btn-primary" type="button">Download PNG</button>
              <button id="qrDownloadSvgBtn" class="btn btn-secondary" type="button">Download SVG</button>
            </div>

            <div class="content-card" style="margin-top:24px;">
              <h3>QR guidance</h3>
              <div id="qrTips">
                <p class="muted">QR best-practice guidance will appear here as you fill in the fields.</p>
              </div>
            </div>

          {% elif tool.slug == "qr-barcode-scanner" %}
            <div class="hero-actions" style="margin-bottom:24px;">
              <button id="scannerStartBtn" class="btn btn-primary" type="button">Start Camera</button>
              <button id="scannerStopBtn" class="btn btn-secondary" type="button">Stop Camera</button>
            </div>

            <div class="form-group">
              <label for="scannerFileInput">Upload image (QR or barcode)</label>
              <input id="scannerFileInput" class="tool-input" type="file" accept="image/*">
            </div>

            <div class="results-grid">
              <div class="result-box">
                <strong id="scannerSupportStatus">Checking…</strong>
                <span>Browser support</span>
              </div>
              <div class="result-box">
                <strong id="scannerCameraStatus">Idle</strong>
                <span>Camera</span>
              </div>
              <div class="result-box">
                <strong id="scannerDetectedFormat">-</strong>
                <span>Format</span>
              </div>
              <div class="result-box">
                <strong id="scannerDetectionMode">-</strong>
                <span>Detection mode</span>
              </div>
            </div>

            <div class="content-card" style="margin-top:24px;">
              <h3>Live scanner</h3>
              <div style="position:relative; overflow:hidden; border-radius:16px; background:#000;">
                <video id="scannerVideo" playsinline muted style="width:100%; min-height:280px; background:#000;"></video>
              </div>
              <p class="muted" style="margin-top:12px;">Point your camera at a QR code or supported barcode once scanning starts.</p>
            </div>

            <div class="content-card" style="margin-top:24px;">
              <h3>Uploaded image preview</h3>
              <div id="scannerImagePreview" class="preview-box" style="min-height:220px;">
                <p class="muted">Upload an image to scan a QR code or barcode without using the camera.</p>
              </div>
            </div>

            <div class="content-card" style="margin-top:24px;">
              <h3>Decoded result</h3>
              <textarea id="scannerResult" class="tool-input" rows="6" readonly placeholder="Scanned content will appear here..."></textarea>
            </div>

            <div class="content-card" style="margin-top:24px;">
              <h3>Scanner guidance</h3>
              <div id="scannerTips">
                <p class="muted">Scanner tips and support notes will appear here.</p>
              </div>
            </div>

          {% else %}
            <div class="content-card">
              <p>
                The dedicated interface for {{ tool.name }} will be added in the next migration step.
              </p>
            </div>
          {% endif %}
        </div>

        <div class="content-card" style="margin-top:24px;">
          <h2>About the {{ tool.name }}</h2>
          <p>
            {{ tool.description }}
          </p>
        </div>
        {% if tool.guide %}
          <section class="content-card tool-guide" style="margin-top:24px;">
            <div class="section-head">
              <span class="eyebrow">{{ tool.guide.eyebrow }}</span>
              <h2>{{ tool.guide.title }}</h2>
              {% for paragraph in tool.guide.intro %}
                <p class="section-desc">{{ paragraph }}</p>
              {% endfor %}
            </div>

            <div class="guide-block">
              <h3>{{ tool.guide.stepsTitle }}</h3>
              <div class="guide-steps">
                {% for step in tool.guide.steps %}
                  <div class="guide-step">
                    <strong>{{ loop.index }}. {{ step.title }}</strong>
                    <p>{{ step.text }}</p>
                  </div>
                {% endfor %}
              </div>
            </div>

            <div class="guide-block">
              <h3>{{ tool.guide.exampleTitle }}</h3>
              <p class="muted">{{ tool.guide.exampleIntro }}</p>
              <dl class="example-list">
                {% for item in tool.guide.example %}
                  <div>
                    <dt>{{ item.label }}</dt>
                    <dd>{{ item.value }}</dd>
                  </div>
                {% endfor %}
              </dl>
            </div>

            <div class="guide-block">
              <h3>{{ tool.guide.bestPracticesTitle }}</h3>
              <ul class="check-list">
                {% for item in tool.guide.bestPractices %}
                  <li>{{ item }}</li>
                {% endfor %}
              </ul>
            </div>

            {% if tool.relatedArticles %}
              <div class="guide-block guide-related">
                <h3>{{ tool.guide.relatedTitle }}</h3>
                <p class="muted">{{ tool.guide.relatedText }}</p>
                <div class="related-link-grid">
                  {% for slug in tool.relatedArticles %}
                    {% for article in articles %}
                      {% if article.slug == slug %}
                        <a href="/articles/{{ article.slug }}/">{{ article.title }}</a>
                      {% endif %}
                    {% endfor %}
                  {% endfor %}
                </div>
              </div>
            {% endif %}

            {% if tool.workflowLinks %}
              <div class="guide-block guide-related">
                <h3>{{ tool.workflowLinks.title }}</h3>
                <p class="muted">{{ tool.workflowLinks.text }}</p>
                <div class="related-link-grid">
                  {% for link in tool.workflowLinks.links %}
                    <a href="{{ link.url }}">{{ link.label }}</a>
                  {% endfor %}
                </div>
              </div>
            {% endif %}
          </section>
        {% endif %}



        {% if tool.faq %}
          <section class="content-card faq-section" style="margin-top:24px;">
            <div class="section-head">
              <span class="eyebrow">FAQ</span>
              <h2>Frequently asked questions</h2>
              <p class="section-desc">Quick answers for visitors using {{ tool.name }}.</p>
            </div>

            <div class="faq-list">
              {% for item in tool.faq %}
                <details class="faq-item">
                  <summary>{{ item.question }}</summary>
                  <p>{{ item.answer }}</p>
                </details>
              {% endfor %}
            </div>
          </section>
        {% endif %}
      </div>

      <aside{% if tool.slug == 'utm-builder' %} class="utm-builder-resources"{% elif tool.slug == 'keyword-density-checker' or tool.slug == 'utm-link-checker' or tool.slug == 'meta-tag-generator' or tool.slug == 'cpc-roas-calculator' or tool.slug == 'word-counter' or tool.slug == 'readability-checker' or tool.slug == 'serp-snippet-preview' %} class="task-tool-resources"{% endif %}>
        <div class="sidebar-card">
          <h3>Related tools</h3>
          <ul class="list-clean">
            {% for item in tools %}
              {% if item.slug != tool.slug and item.featured %}
                <li><a class="mini-link" href="{{ item.url }}">{{ item.name }}</a></li>
              {% endif %}
            {% endfor %}
          </ul>
        </div>

        {% if tool.relatedArticles %}
          <div class="sidebar-card" style="margin-top:24px;">
            <h3>Related guides</h3>
            <ul class="list-clean">
              {% for slug in tool.relatedArticles %}
                {% for article in articles %}
                  {% if article.slug == slug %}
                    <li><a class="mini-link" href="/articles/{{ article.slug }}/">{{ article.title }}</a></li>
                  {% endif %}
                {% endfor %}
              {% endfor %}
            </ul>
          </div>
        {% endif %}
      </aside>
    </div>
  </div>
</section>

{% if tool.slug == "word-counter" %}
  <script src="/assets/js/word-counter.js?v=20260909-phase6"></script>
{% elif tool.slug == "keyword-density-checker" %}
  <script src="/assets/js/keyword-density.js?v=20260909-phase3"></script>
{% elif tool.slug == "readability-checker" %}
  <script src="/assets/js/readability-checker.js?v=20260909-phase6"></script>
{% elif tool.slug == "meta-tag-generator" %}
  <script src="/assets/js/meta-tag-generator.js?v=20260909-phase5"></script>
{% elif tool.slug == "serp-snippet-preview" %}
  <script src="/assets/js/serp-snippet-preview.js?v=20260909-phase6"></script>
{% elif tool.slug == "cpc-roas-calculator" %}
  <script src="/assets/js/cpc-roas-calculator.js?v=20260909-phase5"></script>
{% elif tool.slug == "utm-builder" %}
  <script src="/assets/js/campaign-url-builder.js"></script>
{% elif tool.slug == "utm-link-checker" %}
  <script src="/assets/js/utm-link-checker.js?v=20260909-phase3"></script>
{% elif tool.slug == "qr-code-generator" %}
  <script src="/assets/js/qr-code-generator.js"></script>
{% elif tool.slug == "qr-barcode-scanner" %}
  <script src="https://unpkg.com/jsqr/dist/jsQR.js"></script>
  <script src="/assets/js/qr-barcode-scanner.js"></script>
{% endif %}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": {{ tool.name | dump | safe }},
  "url": "{{ site.url }}{{ tool.url }}",
  "description": {{ tool.description | dump | safe }},
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "Any",
  "browserRequirements": "Requires a modern web browser with JavaScript enabled",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": {{ site.name | dump | safe }},
    "url": {{ site.url | dump | safe }}
  }
}
</script>

{% if tool.faq %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {% for item in tool.faq %}
    {
      "@type": "Question",
      "name": "{{ item.question }}",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "{{ item.answer }}"
      }
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
}
</script>
{% endif %}

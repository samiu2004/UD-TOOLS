      </div>
    </form>

    <nav class="directory-shortcuts" aria-label="Popular tools">
      <span>Popular:</span>
      <a href="/tools/utm-builder/">UTM Builder</a>
      <a href="/tools/keyword-density-checker/">Keyword Density Checker</a>
      <a href="/tools/utm-link-checker/">UTM Link Checker</a>
    </nav>
  </div>
</section>

<section id="all-tools" class="section directory-workspace tools-directory-section" aria-labelledby="all-tools-title">
  <div class="container">
    <div class="directory-heading">
      <div>
        <span class="eyebrow">All Tools</span>
        <h2 id="all-tools-title">Choose the job you need to finish.</h2>
      </div>
      <p>Filter by workflow or search by task. Every tool runs in your browser without signup.</p>
    </div>

    <div class="tool-filter-bar" aria-label="Filter tools by category" data-tool-filters>
      <button class="is-active" type="button" data-tool-filter="all" aria-pressed="true">All tools</button>
      <button type="button" data-tool-filter="writing" aria-pressed="false">Writing</button>
      <button type="button" data-tool-filter="seo" aria-pressed="false">SEO</button>
      <button type="button" data-tool-filter="metadata" aria-pressed="false">Metadata</button>
      <button type="button" data-tool-filter="campaign" aria-pressed="false">Campaigns</button>
      <button type="button" data-tool-filter="utility" aria-pressed="false">QR utilities</button>
    </div>
    <p class="tool-filter-status" aria-live="polite" data-tool-status>{{ tools | length }} tools available</p>

    <div class="tool-directory-grid" data-tool-grid>
      {% for tool in tools %}
        {{ toolCard(tool) }}
      {% endfor %}
    </div>
  </div>
</section>

